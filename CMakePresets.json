{
  "buildPresets": [
    {
      "configuration": "Debug",
      "configurePreset": "clang",
      "displayName": "Build with Ninja/Clang (Debug)",
      "jobs": 8,
      "name": "clang-debug"
    },
    {
      "configuration": "Release",
      "configurePreset": "clang",
      "displayName": "Build with Ninja/Clang (Release)",
      "jobs": 8,
      "name": "clang-release"
    },
    {
      "condition": {
        "lhs": "${hostSystemName}",
        "rhs": "Windows",
        "type": "equals"
      },
      "configuration": "Debug",
      "configurePreset": "msvc",
      "displayName": "Build with MSVC (Debug)",
      "jobs": 8,
      "name": "msvc-debug",
      "nativeToolOptions": [
        "-fileLogger",
        "-flp1:logfile=${sourceDir}/logs/build/${presetName}-errors.txt;errorsonly",
        "-flp2:logfile=${sourceDir}/logs/build/${presetName}-warnings.txt;warningsonly",
        "-terminalLogger:on"
      ]
    },
    {
      "configuration": "Release",
      "displayName": "Build with MSVC (Release)",
      "inherits": "msvc-debug",
      "name": "msvc-release"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "binaryDir": "${fileDir}/Builds/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_COLOR_DIAGNOSTICS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_CXX_SCAN_FOR_MODULES": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_OPTIMIZE_DEPENDENCIES": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_PROJECT_INCLUDE": {
          "type": "STRING",
          "value": "${sourceDir}/config/Warnings.cmake"
        },
        "CTEST_NO_TESTS_ACTION": {
          "type": "STRING",
          "value": "error"
        },
        "CTEST_OUTPUT_ON_FAILURE": {
          "type": "BOOL",
          "value": "ON"
        },
        "CTEST_PROGRESS_OUTPUT": {
          "type": "BOOL",
          "value": "ON"
        },
        "DOXYGEN_WARN_LOGFILE": {
          "type": "FILEPATH",
          "value": "${sourceDir}/logs/Doxygen.log"
        }
      },
      "hidden": true,
      "name": "base",
      "vendor": {
        "jetbrains.com/clion": {
          "enablePythonIntegration": true
        }
      },
      "warnings": {
        "deprecated": true,
        "dev": true,
        "systemVars": false,
        "uninitialized": true,
        "unusedCli": false
      }
    },
    {
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": {
          "type": "STRING",
          "value": "clang++"
        },
        "CMAKE_CXX_FLAGS": {
          "type": "STRING",
          "value": "-stdlib=libc++"
        },
        "CMAKE_C_COMPILER": {
          "type": "STRING",
          "value": "clang"
        }
      },
      "displayName": "Build with Ninja & Clang",
      "generator": "Ninja Multi-Config",
      "inherits": "base",
      "name": "clang"
    },
    {
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-fsanitize=address -fsanitize-address-use-after-scope -fno-omit-frame-pointer"
        },
        "CMAKE_C_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-fsanitize=address -fsanitize-address-use-after-scope -fno-omit-frame-pointer"
        }
      },
      "displayName": "Build with Ninja & Clang (ASAN)",
      "inherits": "clang",
      "name": "clang-asan"
    },
    {
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-fsanitize=undefined"
        },
        "CMAKE_C_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-fsanitize=undefined"
        }
      },
      "displayName": "Build with Ninja & Clang (UBSAN)",
      "inherits": "clang",
      "name": "clang-ubsan"
    },
    {
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": {
          "type": "STRING",
          "value": "g++-14"
        },
        "CMAKE_CXX_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-g -fprofile-arcs -ftest-coverage"
        },
        "CMAKE_C_COMPILER": {
          "type": "STRING",
          "value": "gcc-14"
        },
        "CMAKE_C_FLAGS_DEBUG": {
          "type": "STRING",
          "value": "-g -fprofile-arcs -ftest-coverage"
        }
      },
      "displayName": "Build with Ninja & GCC",
      "generator": "Ninja Multi-Config",
      "inherits": "base",
      "name": "gcc"
    },
    {
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": {
          "type": "STRING",
          "value": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
        }
      },
      "condition": {
        "lhs": "${hostSystemName}",
        "rhs": "Windows",
        "type": "equals"
      },
      "displayName": "Build with MSVC",
      "generator": "Visual Studio 17 2022",
      "inherits": "base",
      "name": "msvc"
    }
  ],
  "version": 10
}

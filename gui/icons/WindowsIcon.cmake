include_guard (GLOBAL)

if (NOT WIN32)
    return ()
endif ()

find_program (IMAGEMAGICK_PROGRAM magick DOC "ImageMagick executable, used for creating .ico files")

add_feature_info (
    benbot_win_app_icon IMAGEMAGICK_PROGRAM
    "Generating app icon for Windows (requires ImageMagick)"
)

if (NOT IMAGEMAGICK_PROGRAM)
    return ()
endif ()

set (ico_output "${CMAKE_CURRENT_BINARY_DIR}/icon.ico")

add_custom_command (
    OUTPUT "${ico_output}"
    COMMAND "${IMAGEMAGICK_PROGRAM}" "${BENBOT_APP_ICON_SVG}" -define
            icon:auto-resize=256,128,64,48,32,16 "${ico_output}"
    DEPENDS "${BENBOT_APP_ICON_SVG}"
    COMMENT "Generating Windows .ico file..."
    VERBATIM USES_TERMINAL
)

target_sources (benbot_gui PRIVATE icons/icon.rc "${ico_output}")
